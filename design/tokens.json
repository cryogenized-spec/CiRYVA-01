  "status": "proposed",
  "theme": "industrial-futurist-dark",
  "colors": {
    "canvas": "#0A0C10",
    "backgroundRaised": "#11151B",
    "surface": "#151A21",
    "surfaceElevated": "#1C232C",
    "textPrimary": "#EAF2FF",
    "textSecondary": "#9FB0C5",
    "electricBlue": "#27B2FF",
    "luminousBlue": "#66D4FF",
    "accentMuted": "#3E6D8A"
