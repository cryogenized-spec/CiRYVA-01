    "section": {
      "family": "Orbitron",
      "sizeSp": 16,
      "lineHeightSp": 23,
      "weight": 500
    },
    "body": {
      "family": "Inter-or-Manrope-to-review",
      "sizeSp": 16,
      "lineHeightSp": 24,
      "weight": 400
    },
    "navigation": {
      "family": "system-sans",
      "sizeSp": 14,
      "lineHeightSp": 20,
      "weight": 500
    },
    "metadata": {
      "family": "system-sans",
      "sizeSp": 12,
      "lineHeightSp": 17,
      "weight": 400
    },
    "technical": {
      "family": "system-monospace",
      "sizeSp": 13,
      "lineHeightSp": 20,
      "weight": 400
    }
